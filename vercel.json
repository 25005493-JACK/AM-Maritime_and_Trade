{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm --prefix frontend install",
  "rewrites": [
    { "source": "/presentation", "destination": "/presentation.html" },
    { "source": "/slides", "destination": "/presentation.html" },
    { "source": "/api/emails", "destination": "/api/emails.json" },
    { "source": "/api/emails/", "destination": "/api/emails.json" },
    { "source": "/api/emails/:id((?!.*\\.json$).*)", "destination": "/api/emails/:id.json" },
    { "source": "/api/analytics", "destination": "/api/analytics.json" },
    { "source": "/api/calendar", "destination": "/api/calendar.json" },
    { "source": "/api/reflections", "destination": "/api/reflections.json" },
    { "source": "/api/routing-policy", "destination": "/api/routing_policy.json" },
    { "source": "/api/routing_policy", "destination": "/api/routing_policy.json" },
    { "source": "/api/dcsa-analytics", "destination": "/api/dcsa_analytics.json" },
    { "source": "/api/dcsa_analytics", "destination": "/api/dcsa_analytics.json" },
    { "source": "/api/automation-level", "destination": "/api/automation_level.json" },
    { "source": "/api/settings/automation-level", "destination": "/api/automation_level.json" },
    { "source": "/api/ocr/dashboard", "destination": "/api/ocr_dashboard.json" },
    { "source": "/api/ocr_dashboard", "destination": "/api/ocr_dashboard.json" },
    { "source": "/((?!api/|assets/|presentation\\.html|favicon\\.ico).*)", "destination": "/index.html" }
  ]
}
